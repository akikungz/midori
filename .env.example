# Copy to .env and adjust values for your environment.

APP_ENV=development # example: development | production | test
LOG_LEVEL=debug # example: trace | debug | info | warn | error | fatal
OTEL_SERVICE_NAME=midori-dev # example: midori-dev

# API endpoints
SERVER_API_URL=http://momoi-development:3000 # example: http://localhost:3000
AUTH_API_URL=http://arisu:3001 # example: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000 # example: public base URL for client auth requests

# Observability (optional)
OTEL_EXPORTER_OTLP_AUTH_MODE=none # example: none | bearer | basic
# OTEL_EXPORTER_OTLP_AUTH_TOKEN=your-token # use for bearer auth
# OTEL_EXPORTER_OTLP_AUTH_USERNAME=otel-user # use with basic auth
# OTEL_EXPORTER_OTLP_AUTH_PASSWORD=otel-password # use with basic auth
OTEL_EXPORTER_OTLP_PROTOCOL=grpc # example: grpc | http
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 # grpc uses collector host:port, http typically uses 4318
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc # optional per-signal protocol override
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317 # grpc endpoint should not include /v1/traces
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc # optional per-signal protocol override
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317 # grpc endpoint should not include /v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=grpc # optional per-signal protocol override
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4317 # grpc endpoint should not include /v1/logs
OTEL_METRIC_EXPORT_INTERVAL=10000 # optional export interval in milliseconds
